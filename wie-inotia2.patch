 async fn read_packaged_database(context: &mut dyn WIPICContext, name: &str) -> Result<Option<Vec<u8>>> {
+    // On KTF handsets a database is a file in the app's `P/` directory, and
+    // add-on data downloaded after install lives there too. Archives dumped
+    // from a handset carry those files, so prefer them over the jar copy.
+    let filesystem = context.system().filesystem().clone();
+    if let Some(size) = filesystem.size(name).await {
+        let mut data = vec![0; size];
+        let read = filesystem.read(name, 0, size, &mut data).await.unwrap_or(0);
+        data.truncate(read);
+        return Ok(Some(data));
+    }
+
     if context.get_resource_size(name).await?.is_none() {
         return Ok(None);
     }
